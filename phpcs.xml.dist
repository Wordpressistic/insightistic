<?xml version="1.0"?>
<ruleset name="Insightistic">
    <description>Coding standard for the Insightistic plugin.</description>

    <!-- Scan these directories. -->
    <file>.</file>

    <!-- Ignore non-plugin directories and vendored/built assets. -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/scripts/*</exclude-pattern>
    <exclude-pattern>/assets/js/vendor/*</exclude-pattern>
    <exclude-pattern>/assets/js/*.min.js</exclude-pattern>
    <exclude-pattern>/assets/js/*.min.js.map</exclude-pattern>
    <exclude-pattern>/assets/css/*.min.css</exclude-pattern>
    <exclude-pattern>/\.github/*</exclude-pattern>
    <exclude-pattern>/composer.lock</exclude-pattern>
    <exclude-pattern>/package-lock.json</exclude-pattern>

    <!-- WordPress Coding Standards. -->
    <rule ref="WordPress">
        <!-- The plugin ships its own translation template; leaving the
             .pot out of text-domain sniff enforcement is not needed,
             but ignore the README marker checks (readme.txt is verified
             by scripts/validate-release.php instead). -->
        <exclude name="WordPress.WP.DeprecatedFunctions"/>

        <!-- Minified asset mtime comparison in class-insightistic-admin.php
             legitimately calls filemtime twice on one line. -->
    </rule>

    <!-- Enforce the minimum supported PHP version. -->
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Properties for WPCS. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="insightistic"/>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array" value="insightistic"/>
        </properties>
    </rule>
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
            <property name="is_plugin" value="true"/>
        </properties>
    </rule>

    <!-- CLI scripts and uninstall.php may be executed outside WP. -->
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>/uninstall\.php</exclude-pattern>
    </rule>
</ruleset>
