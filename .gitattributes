# Normalize line endings: LF in repo and on checkout for all text files.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets — never normalize.
*.png binary
*.zip binary
*.map binary

# Force LF for source even if editors disagree.
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.pot text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.dist text eol=lf
*.lock text eol=lf
