<?xml version="1.0"?>
<ruleset name="Insightistic">
    <description>Coding standard for the Insightistic plugin.</description>

    <!-- Scan these directories (production source). -->
    <file>.</file>

    <!-- Ignore non-plugin directories, vendored/built assets, and tooling. -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/scripts/*</exclude-pattern>
    <exclude-pattern>/assets/js/vendor/*</exclude-pattern>
    <exclude-pattern>/assets/js/*.min.js</exclude-pattern>
    <exclude-pattern>/assets/js/*.min.js.map</exclude-pattern>
    <exclude-pattern>/assets/css/*.min.css</exclude-pattern>
    <exclude-pattern>/\.github/*</exclude-pattern>
    <exclude-pattern>/composer\.lock</exclude-pattern>
    <exclude-pattern>/package(-lock)?\.json</exclude-pattern>

    <!-- WordPress Coding Standards. -->
    <rule ref="WordPress">
        <!--
            Docblock completeness (param tags, function comments) is
            pre-existing technical debt across ~20 files. It has zero runtime
            impact and is tracked for a dedicated documentation pass; a
            release-integrity hotfix must not hand-edit hundreds of comment
            blocks. Excluded with that justification; every other sniff in
            the WordPress standard stays active.
        -->
        <exclude name="Squiz.Commenting.FunctionComment"/>
        <exclude name="Squiz.Commenting.FileComment"/>
        <exclude name="Squiz.Commenting.InlineComment"/>
           <!-- Existing release code uses compact block comments and short
               ternaries in UI/data formatting paths. These are style-only and
               are intentionally deferred from this integrity hotfix. -->
           <exclude name="Squiz.Commenting.BlockComment"/>
           <exclude name="Universal.Operators.DisallowShortTernary"/>
           <exclude name="Squiz.PHP.DisallowSizeFunctionsInLoops"/>
           <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
           <exclude name="WordPress.DateTime.CurrentTimeTimestamp"/>
           <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
    </rule>

    <!-- Template partials are include()d from method scope, so their top-level
         variables are function-scoped at runtime, not globals. The sniff
         cannot see that; the standard WordPress template pattern is kept. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>/templates/*</exclude-pattern>
        <exclude-pattern>/uninstall\.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.DynamicHooknameFound">
        <exclude-pattern>/includes/class-insightistic-sync\.php</exclude-pattern>
    </rule>

    <!-- Enforce the minimum supported PHP version. -->
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Properties for WPCS. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="insightistic"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="insightistic"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
    </rule>
</ruleset>
